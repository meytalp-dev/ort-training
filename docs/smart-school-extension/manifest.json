{
  "manifest_version": 3,
  "name": "ImpactOS ↔ SmartSchool",
  "version": "0.1.0",
  "description": "מעביר ציוני תרגול מ-ImpactOS לטפסי SmartSchool בלחיצה אחת. פיילוט אורט בית הערבה.",
  "default_locale": "he",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.smart-school.co.il/*",
    "*://*.smartschool.co.il/*",
    "*://*.smart-school.org.il/*",
    "*://localhost/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ImpactOS ↔ SmartSchool"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.smart-school.co.il/*",
        "*://*.smartschool.co.il/*",
        "*://*.smart-school.org.il/*"
      ],
      "js": ["content/smartschool-detector.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
